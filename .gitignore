# --- personal Claude Code config (shared config in .claude/settings.json and .claude/commands/ is committed) ---
.claude/settings.local.json
CLAUDE.local.md

# --- IDE / editor ---
.vscode/
.idea/
.cache/
compile_commands.json
*.swp
*~
.DS_Store

