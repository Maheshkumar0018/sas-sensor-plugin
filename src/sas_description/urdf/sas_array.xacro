<?xml version="1.0"?>
<!-- Copyright 2026 The SAS Sensor Plugin Authors
     SPDX-License-Identifier: Apache-2.0

     Reusable SAS array macro (REQ-014). Include it in any vehicle model and call
       <xacro:sas_array parent="base_link" xyz="..." rpy="..."/>
     Array frame: x = boresight, y = along-track, z = up. The sensor reads its motion from the
     parent link; it never moves itself (ADR-0005). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:macro name="sas_array"
               params="parent xyz rpy prefix:=''
                       sensor_type:=gpu_ray prf:=10.0 h_samples:=512 v_samples:=512
                       num_elements:=16 element_spacing:=0.04
                       topic:=/sas/ping seed:=12345 cell_size:=0.04 noise_std:=1e-7 debug:=false">

    <link name="${prefix}sas_array_link">
      <inertial>
        <mass value="0.5"/>
        <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
      </inertial>
      <visual>
        <geometry><box size="0.04 ${num_elements * element_spacing} 0.04"/></geometry>
      </visual>
    </link>

    <joint name="${prefix}sas_array_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}sas_array_link"/>
      <origin xyz="${xyz}" rpy="${rpy}"/>
    </joint>

    <!-- Gazebo lumps fixed joints: the sensor ends up on the parent link with the joint offset as
         its pose. The plugin composes sensor pose and link pose, so the result is the same. -->
    <gazebo reference="${prefix}sas_array_link">
      <sensor type="${sensor_type}" name="${prefix}sas_sonar">
        <always_on>true</always_on>
        <update_rate>${prf}</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan>
            <!-- Shadows need fine rays: ~0.002 rad at 512 samples (plan 004 log). -->
            <horizontal>
              <samples>${h_samples}</samples>
              <resolution>1</resolution>
              <min_angle>-0.40</min_angle>
              <max_angle>0.40</max_angle>
            </horizontal>
            <vertical>
              <samples>${v_samples}</samples>
              <resolution>1</resolution>
              <min_angle>-0.80</min_angle>
              <max_angle>0.20</max_angle>
            </vertical>
          </scan>
          <range>
            <min>1.0</min>
            <max>70.0</max>
            <resolution>0.001</resolution>
          </range>
        </ray>

        <plugin name="${prefix}sas_sonar_plugin" filename="libsas_sonar_plugin.so">
          <ros>
            <namespace>/sas</namespace>
          </ros>
          <topic>${topic}</topic>
          <frame_id>${prefix}sas_array_link</frame_id>

          <!-- Waveform (REQ-001) -->
          <sound_speed>1500.0</sound_speed>
          <center_frequency>100000.0</center_frequency>
          <bandwidth>20000.0</bandwidth>
          <pulse_length>0.005</pulse_length>
          <sample_rate>40000.0</sample_rate>
          <min_range>2.0</min_range>
          <max_range>60.0</max_range>

          <!-- Array and beams (REQ-002, REQ-003) -->
          <num_elements>${num_elements}</num_elements>
          <element_spacing>${element_spacing}</element_spacing>
          <element_length>0.04</element_length>
          <element_height>0.015</element_height>
          <tx_length>0.04</tx_length>
          <tx_height>0.015</tx_height>

          <!-- Scene (REQ-004, REQ-005, REQ-007) -->
          <cell_size>${cell_size}</cell_size>
          <max_incidence_deg>88.0</max_incidence_deg>
          <default_backscatter_db>-27.0</default_backscatter_db>

          <!-- Propagation and output (REQ-006, REQ-009) -->
          <source_level>0.0</source_level>
          <!-- <absorption_db_per_m>0.034</absorption_db_per_m>  default: Thorp at fc -->
          <noise_std>${noise_std}</noise_std>
          <seed>${seed}</seed>
          <debug_scatterers>${debug}</debug_scatterers>
          <!-- <strict_rate>true</strict_rate>  default: on for ray, off for gpu_ray (ADR-0010) -->
        </plugin>
      </sensor>
    </gazebo>
  </xacro:macro>
</robot>
