<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sas_gazebo</name>
  <version>0.0.0</version>
  <description>Gazebo Classic 11 sensor plugin that simulates a Synthetic Aperture Sonar array.</description>
  <maintainer email="bojanapu.k@mgtechsoft.com">bojanapu.k</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_dev</depend>
  <depend>gazebo_ros</depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>sas_msgs</depend>
  <depend>ignition-math6</depend>
  <depend>libfftw3</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros plugin_path="${prefix}/lib"/>
  </export>
</package>
