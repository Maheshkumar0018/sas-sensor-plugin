<?xml version="1.0"?>
<!-- Copyright 2026 The SAS Sensor Plugin Authors
     SPDX-License-Identifier: Apache-2.0

     Survey world: sand seabed with targets on the starboard side of the default leg
     (carrier starts at x = -10 and moves along +x at 10 m altitude).
     <laser_retro> = Lambert backscatter mu (linear), REQ-007. It is set on both the visual
     (read by gpu_ray) and the collision (read by CPU ray). 0 means default_backscatter_db.
     sand 0.002 (-27 dB), rock 0.02 (-17 dB), metal 0.3 (-5 dB), point/plate target 1.0 (0 dB). -->
<sdf version="1.6">
  <world name="sas_seabed">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>0.2 0.3 0.4 1</ambient>
      <background>0.0 0.1 0.2 1</background>
      <shadows>false</shadows>
    </scene>
    <include><uri>model://sun</uri></include>

    <!-- Sand seabed, top surface at z = 0 -->
    <model name="seabed">
      <static>true</static>
      <link name="link">
        <collision name="c">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>400 400 0.1</size></box></geometry>
          <laser_retro>0.002</laser_retro>
        </collision>
        <visual name="v">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry><box><size>400 400 0.1</size></box></geometry>
          <laser_retro>0.002</laser_retro>
          <material><ambient>0.76 0.70 0.50 1</ambient><diffuse>0.76 0.70 0.50 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Cylinder (mine-like), 0.5 m diameter, 2 m long, lying on the seabed -->
    <model name="cylinder_target">
      <static>true</static>
      <pose>20 -20 0.25 1.5708 0 0.6</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry><laser_retro>0.3</laser_retro></collision>
        <visual name="v"><geometry><cylinder><radius>0.25</radius><length>2.0</length></cylinder></geometry><laser_retro>0.3</laser_retro></visual>
      </link>
    </model>
    <!-- Sphere, 0.8 m diameter -->
    <model name="sphere_target">
      <static>true</static>
      <pose>28 -25 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.4</radius></sphere></geometry><laser_retro>0.3</laser_retro></collision>
        <visual name="v"><geometry><sphere><radius>0.4</radius></sphere></geometry><laser_retro>0.3</laser_retro></visual>
      </link>
    </model>
    <!-- Box, 1.0 x 0.6 x 0.5 m -->
    <model name="box_target">
      <static>true</static>
      <pose>35 -30 0.25 0 0 0.3</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.6 0.5</size></box></geometry><laser_retro>0.3</laser_retro></collision>
        <visual name="v"><geometry><box><size>1.0 0.6 0.5</size></box></geometry><laser_retro>0.3</laser_retro></visual>
      </link>
    </model>
    <!-- Small bright sphere; below the ray resolution at long range, so it may give few scatterers -->
    <model name="small_target">
      <static>true</static>
      <pose>40 -18 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.05</radius></sphere></geometry><laser_retro>1.0</laser_retro></collision>
        <visual name="v"><geometry><sphere><radius>0.05</radius></sphere></geometry><laser_retro>1.0</laser_retro></visual>
      </link>
    </model>
    <!-- Rocks: half-buried spheres -->
    <model name="rock_1">
      <static>true</static>
      <pose>24 -34 0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.6</radius></sphere></geometry><laser_retro>0.02</laser_retro></collision>
        <visual name="v"><geometry><sphere><radius>0.6</radius></sphere></geometry><laser_retro>0.02</laser_retro></visual>
      </link>
    </model>
    <model name="rock_2">
      <static>true</static>
      <pose>32 -14 0 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><sphere><radius>0.4</radius></sphere></geometry><laser_retro>0.02</laser_retro></collision>
        <visual name="v"><geometry><sphere><radius>0.4</radius></sphere></geometry><laser_retro>0.02</laser_retro></visual>
      </link>
    </model>
  </world>
</sdf>
